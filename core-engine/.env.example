# 火山引擎 Ark API Token(从 4 个中任选其一填入,遇限流可切换)
# 切勿提交到 Git / 公开仓库 / 截图 / 日志
ARK_API_KEY=在这里粘贴所选_Token

# 赛博财神庙求签接口鉴权 token(板端请求头 X-Fortune-Token,留空则不校验)
FORTUNE_API_TOKEN=

# 火山引擎语音合成大模型 TTS(豆包语音 Seed TTS 2.0);从语音控制台「应用管理」获取
# 与 ARK_API_KEY 是两套独立凭证,切勿混用
VOLC_TTS_APPID=在这里粘贴_App_ID
VOLC_TTS_TOKEN=在这里粘贴_Access_Token
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=zh_male_naiqimengwa_mars_bigtts
